{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/app.html" },
    { "source": "/api/trip", "destination": "/api/trip.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
